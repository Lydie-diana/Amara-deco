{
  "expo": {
    "name": "Amara",
    "slug": "amara",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "amara",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "android", "web"],
    "backgroundColor": "#F6F1EA",
    "web": {
      "output": "server",
      "bundler": "metro"
    },
    "plugins": ["expo-router", "expo-localization", "expo-font", "expo-video"],
    "experiments": {
      "reactCompiler": true
    }
  }
}
